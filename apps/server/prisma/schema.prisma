generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Example models based on the Master Plan:
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  projects  Project[]
}

model Project {
  id        String    @id @default(uuid())
  name      String
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
}
