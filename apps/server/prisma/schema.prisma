// Single source of truth for the entire monorepo.
// Run `corepack yarn prisma generate` from apps/server to regenerate both clients.

generator client_server {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator client_web {
  provider = "prisma-client"
  output   = "../../web/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String    @id @default(uuid())
  email    String    @unique
  name     String
  projects Project[]
}

model Project {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  name      String
  language  String   @default("Python")
  ownerId   String
  joinCode  String   @unique @default(cuid())
  createdAt DateTime @default(now())

  @@map("sessions")
}
